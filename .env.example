# QUANTUM//OPS Configuration
QUANTUM_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Quantum Frameworks
# Default execution mode: cpu_simulator (runs on standard CPU)
DEFAULT_SIMULATION_BACKEND=cpu_simulator

# IBM Quantum API Credentials (Optional - not required for local simulation)
IBM_QUANTUM_TOKEN=

# Logging
LOG_LEVEL=INFO
